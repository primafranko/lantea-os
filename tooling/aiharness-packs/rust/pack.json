{
  "name": "rust",
  "kind": "stack",
  "description": "Rust with Cargo: rustfmt, clippy (-D warnings) and cargo test",
  "requires": [],
  "detect": {
    "files_any": [
      "Cargo.toml"
    ]
  },
  "harness": {
    "packages": [
      {
        "name": "rust",
        "root": ".",
        "files": [
          "**/*.rs",
          "**/Cargo.toml",
          "Cargo.lock",
          "!target/**"
        ],
        "commands": {
          "format": {
            "run": "cargo fmt --all",
            "scope": "package",
            "timeout": 120,
            "needs": {
              "files_any": [
                "Cargo.toml"
              ]
            }
          },
          "format.check": {
            "run": "cargo fmt --all -- --check",
            "scope": "package",
            "timeout": 180,
            "needs": {
              "files_any": [
                "Cargo.toml"
              ]
            }
          },
          "lint": {
            "run": "cargo clippy --workspace --all-targets --locked -- -D warnings",
            "scope": "package",
            "timeout": 900,
            "needs": {
              "files_any": [
                "Cargo.toml"
              ]
            }
          },
          "test": {
            "run": "cargo test --workspace --locked",
            "scope": "package",
            "timeout": 900,
            "needs": {
              "files_any": [
                "Cargo.toml"
              ]
            }
          }
        }
      }
    ],
    "phases": {
      "edit": [
        "format"
      ],
      "stop": [
        "lint",
        "test"
      ],
      "verify": [
        "format.check",
        "lint",
        "test"
      ]
    },
    "guard": {
      "deny": [],
      "ask": [
        {
          "pattern": "(?:^|[;&|(]|\\$\\()\\s*cargo\\s+update\\b",
          "reason": "changes Cargo.lock for every dependency; only when the spec says so"
        },
        {
          "pattern": "(?:^|[;&|(]|\\$\\()\\s*cargo\\s+(?:publish|yank|owner)\\b",
          "reason": "publishes to crates.io (irreversible); a human does this"
        }
      ]
    }
  },
  "recommended_plugins": [],
  "_note": "Commands run with cwd = the package root; for a Cargo workspace below the repo root, set the package `root` and `files` to that directory in the project harness.json. `--locked` needs a committed Cargo.lock. In a Nix project, prefix the commands with `nix develop -c` in the project harness.json so the flake pins the toolchain. A rust-analyzer LSP plugin is worth installing when one is available in your marketplaces."
}
